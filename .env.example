# ── Sign in with Google ──────────────────────────────────────────────
# OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials
# (type: Web application; add http://localhost:3001 and your production URL
# to "Authorized JavaScript origins"). Public value — safe in the client.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=847354842416-2ck5hm9jqu7hjefl2rvk950i9a5u4nr4.apps.googleusercontent.com

# ── reCAPTCHA v2 checkbox ────────────────────────────────────────────
# Site key from https://www.google.com/recaptcha/admin/create
# (choose "Challenge (v2)" -> "I'm not a robot" checkbox; add localhost and
# your production domain). Public value — safe in the client.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Ld0MlctAAAAANHBaxlzJ6QGVsGN_zlXgA9k18Vn

# NOTE: the matching GOOGLE_CLIENT_ID and RECAPTCHA_SECRET_KEY go in the
# API's .env (xdopestore-api), never in this file.
# Copy this file to .env.local and fill in the values, then rebuild.
