# ── Backend ──────────────────────────────────────────────────────────────
# Base URL of xdopestore-api. Inlined in the client bundle at build time
# (public value). Must be https in production.
API_PROD_URL=http://localhost:5000
# Public URL of this storefront (canonical / metadataBase).
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Admin dashboard URL. When set, admins see a dashboard shortcut in the header.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000

# ── Sign in with Google ──────────────────────────────────────────────
# OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials
# (type: Web application; add http://localhost:3001 and your production URL
# to "Authorized JavaScript origins"). Public value — safe in the client.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── reCAPTCHA v2 checkbox ────────────────────────────────────────────
# Site key from https://www.google.com/recaptcha/admin/create
# (choose "Challenge (v2)" -> "I'm not a robot" checkbox; add localhost and
# your production domain). Public value — safe in the client.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# NOTE: the matching GOOGLE_CLIENT_ID and RECAPTCHA_SECRET_KEY go in the
# API's .env (xdopestore-api), never in this file. Nothing prefixed with
# NEXT_PUBLIC_ is secret: it ships to every browser.
# Copy this file to .env.local and fill in the values, then rebuild.
