# ─── API ──────────────────────────────────────────────────────────────────────
# URL of the xdopestore-api backend (no trailing slash)
API_PROD_URL=http://localhost:5000

# ─── Site ─────────────────────────────────────────────────────────────────────
# Public URL of this storefront (used for SEO, og:url, sitemaps, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Payment redirects ────────────────────────────────────────────────────────
# Where to send the user after a successful / cancelled payment
PAYMENT_RETURN_URL=http://localhost:3000/account/order
PAYMENT_CANCEL_URL=http://localhost:3000/checkout

# ─── Analytics ────────────────────────────────────────────────────────────────
# Google Analytics 4 measurement ID (formato G-XXXXXXX). Fallback si Ajustes
# → Analytics no lo define en el admin.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta Pixel ID. Publico (aparece en el HTML). El access token de CAPI vive
# SOLO en el backend (xdopestore-api/.env → META_CAPI_ACCESS_TOKEN).
NEXT_PUBLIC_META_PIXEL_ID=
